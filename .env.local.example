# Copy to .env.local and fill in the <placeholders>. Only .env.local is read by the
# app, and only .env.local is gitignored — so no real key ever goes in this file.
#
# Every variable here is validated at startup by lib/env.ts. A missing required one
# crashes the build rather than surfacing as a 500 in production at 2am.
#
# Supabase project: kavdpwqtfyffinurfrlc — both values are in the dashboard under
# Project Settings > API.

# ── public: bundled into the client JS. Safe only because RLS is correct everywhere.
NEXT_PUBLIC_SUPABASE_URL=https://kavdpwqtfyffinurfrlc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# ── server only: never prefixed NEXT_PUBLIC_, never imported by a client component
# bypasses all RLS — total data access if leaked
SUPABASE_SERVICE_ROLE_KEY=<service_role key — never commit this>

# ── optional until the layer that needs them
# unbounded billing against your card if leaked.        L2, module 06
GEMINI_API_KEY=<from aistudio.google.com>
# anyone triggers your background jobs if leaked.       PROD, module 15
CRON_SECRET=
SENTRY_DSN=
# forged webhooks -> free premium. Not used until payments are switched on.  module 13
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shared password of the 15 seeded demo accounts (scripts/demo/seed.mjs). Set it on
# Vercel too, or the "Explore the demo" button reports the demo as unavailable.
DEMO_PASSWORD=<long random string>

# Free key from https://www.pexels.com/api/ — only for scripts/demo/fetch-stock.mjs.
PEXELS_API_KEY=

# Show "Continue with Google" on the sign-in page. Enable the provider in Supabase first.
NEXT_PUBLIC_ENABLE_GOOGLE=false

# Read by supabase/config.toml for the local CLI stack only. The hosted project keeps
# these in the Supabase dashboard; the app itself never sends mail, so it never needs
# them at runtime. See docs/email-smtp.md.
RESEND_API_KEY=
SMTP_SENDER_EMAIL=no-reply@<your-domain>
