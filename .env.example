# Copy to .env.local. Every one of these is validated at startup by lib/env.ts —
# a missing key crashes the build rather than surfacing as a 500 at 2am.

# ── public: bundled into the client JS. Safe only because RLS is correct everywhere.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── server only: never prefixed NEXT_PUBLIC_, never imported by a client component
# bypasses all RLS — total data access if leaked
SUPABASE_SERVICE_ROLE_KEY=
# unbounded billing against your card if leaked        (modules 06, 11, 12)
GEMINI_API_KEY=
# anyone triggers your background jobs if leaked        (module 15, PROD)
CRON_SECRET=
SENTRY_DSN=

# module 13, PROD. Vercel Pro must be live before these are.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# `test` raises the per-user AI caps for the 15 testers (module 12).
# Unset it — item 3 on the test → production checklist — before real users.
PHASE=test

# Google OAuth, read by supabase/config.toml for local development only.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
